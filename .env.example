# ─────────────────────────────────────────────────────────────────────────────
# AIATWORK Solar Resolution Dialer — Environment
#
# Copy this file to `.env.local` and fill in your Twilio credentials.
# Without these, the app runs in DEMO MODE: the full UI is interactive and the
# dialer simulates calls so you can explore every screen end-to-end.
# ─────────────────────────────────────────────────────────────────────────────

# Twilio Account (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio API Key + Secret — used to mint Voice access tokens for the browser SDK.
# Create at: Console → Account → API keys & tokens → Standard key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# TwiML Application SID — its Voice URL must point at  /api/twilio/voice
# Create at: Console → Voice → TwiML → TwiML Apps
TWILIO_TWIML_APP_SID=

# The Twilio phone number used as caller ID for outbound calls (E.164, e.g. +14155551234)
TWILIO_CALLER_ID=

# Public base URL Twilio can reach for webhooks/status callbacks.
# Local dev: use an ngrok/tunnel URL. Production: your deployed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
