# ATLAS — environment reference
#
# Copy to .env.local for local dev; in production these are Vercel project
# environment variables (Project → Settings → Environment Variables).
#
# NEVER commit real values. .env.local is gitignored; this file is not.
#
# Everything degrades gracefully: with none of these set the app runs in demo
# mode with simulated dialing, simulated AI, and sample data.
#
# ── Changing a variable in Vercel requires a REDEPLOY to take effect. ─────────

# ─────────────────────────────────────────────────────────────────────────────
# CALLER IDs — the numbers you dial FROM
# ─────────────────────────────────────────────────────────────────────────────

# The rotation pool. Comma- OR newline-separated E.164.
#
# ⚠️  SETTING THIS LOCKS THE POOL PLATFORM-WIDE. While it is set, every org's
#     Admin → Organization → Dialing → "Caller ID rotation pool" is IGNORED —
#     numbers added there silently do nothing. This var becomes the ONLY place
#     the pool can change. Leave it UNSET to let each org manage its own pool
#     from the Admin UI.
#
# ⚠️  It REPLACES the pool, it does not add to it. Always paste the complete
#     list, including the numbers already in use.
TWILIO_CALLER_IDS=+1XXXXXXXXXX,+1XXXXXXXXXX,+1XXXXXXXXXX

# Switch the outbound number every N calls (per rep). Default 0 → every call.
DIAL_ROTATE_EVERY=1

# Single fallback caller ID, used only when no pool is configured. REQUIRED for
# manual PSTN dialing — without it the voice webhook emits <Dial callerId="">
# and the homeowner hears "an application error has occurred".
TWILIO_CALLER_ID=+1XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# TWILIO
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# API key pair + TwiML app — required for the BROWSER dialer (Voice SDK tokens).
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set = AI calls run through a Twilio conference so anyone can listen live, and
# Twilio dials the homeowner with the ROTATED caller ID.
# Unset = "direct" mode: ElevenLabs places the call itself and can only
# originate from numbers IMPORTED into your ElevenLabs account.
TWILIO_AI_BRIDGE_NUMBER=

# Pin Twilio status/recording callbacks to one origin. Leave unset unless a
# stale alias is breaking callbacks.
TWILIO_CALLBACK_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# ELEVENLABS — the AI calling agent
# ─────────────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The ElevenLabs phone-number ID (Conversational AI → Phone Numbers), NOT the
# phone number itself. This is the number every AI call falls back to when
# rotation picks one that isn't imported into ElevenLabs.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Optional second agent (its own script/persona), pickable in the dialer.
ELEVENLABS_AGENT_ID_2=
ELEVENLABS_AGENT_PHONE_NUMBER_ID_2=
ELEVENLABS_AGENT_NAME=Emily
ELEVENLABS_AGENT_NAME_2=

# "true" = never send conversation_config_override; the agent always uses the
# script saved in the ElevenLabs dashboard. Set this when the agent's
# Security → Overrides toggles are off — which is the safe configuration, since
# sending a disallowed override kills the call the instant the homeowner answers.
ELEVENLABS_USE_DASHBOARD_PROMPT=false

# Where the dialer's "Transfer" button sends a live call (org setting wins).
ELEVENLABS_TRANSFER_NUMBER=
# Dev only — never set in production.
ELEVENLABS_ALLOW_UNSIGNED_WEBHOOK=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — auth + database
# ─────────────────────────────────────────────────────────────────────────────
# Absent ⇒ demo mode (demo Owner, full permissions, no persistence).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CLAUDE — briefings, copilot, summaries, auto-disposition, reports
# ─────────────────────────────────────────────────────────────────────────────
# Absent or out of credits ⇒ every AI surface silently falls back to demo
# output. /api/ai/health reports the model, latency and the real failure reason.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=60000
AI_FAST_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# TRANSCRIPTION — recordings → searchable transcripts (manual calls)
# ─────────────────────────────────────────────────────────────────────────────
# "elevenlabs" | "deepgram" | unset (off)
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=scribe_v2
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ─────────────────────────────────────────────────────────────────────────────
# APP / PLATFORM
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.aiatworkdialer.com
# Comma-separated emails with god-mode access to /console.
SUPERADMIN_EMAILS=
# Shared secret for /api/cron/* (scheduled AI calling, transcription sweep).
CRON_SECRET=
NEXT_PUBLIC_DEMO_DATA=false

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL EXTRAS
# ─────────────────────────────────────────────────────────────────────────────
# Outbound email (appointment notifications).
RESEND_API_KEY=
RESEND_FROM=
APPOINTMENT_NOTIFY_EMAILS=

# Reverse phone/address lookup on the lead panel.
REVERSE_SEARCH_PROVIDER=
REVERSE_SEARCH_API_KEY=
REVERSE_SEARCH_API_SECRET=

# SMS safety rail: while set, texts go ONLY to these numbers.
MESSAGING_ALLOWLIST=

# Live-listen media stream (self-hosted socket server, see server/).
MEDIA_STREAM_URL=
MEDIA_STREAM_SECRET=
