# ─────────────────────────────────────────────────────────────────────────────
# AIATWORK Solar Resolution Dialer — Environment
#
# Copy this file to `.env.local` and fill in the values you need:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored on purpose, so your secrets are NEVER committed.
# That's why a fresh clone has no `.env.local` — you create it locally. Nothing
# is "wiped"; this is the standard, safe Next.js setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo data ────────────────────────────────────────────────────────────────
# false (default) → PRODUCTION: every screen is clean with no placeholder data.
# true            → preview the whole app populated with realistic sample data.
NEXT_PUBLIC_DEMO_DATA=false

# ── Supabase (accounts + database) ───────────────────────────────────────────
# Enables login/signup and saves ALL power-dialer data per account. Without it,
# the app runs in demo mode (no auth, in-memory data — resets on refresh).
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
#       → Supabase dashboard → Project Settings → API
#   SUPABASE_SERVICE_ROLE_KEY  (server-only, keep secret)
#       → same page; lets the ElevenLabs post-call webhook attribute results to
#         the right account (it has no user session).
# After setting these, run supabase/schema.sql in the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / Claude (optional) ───────────────────────────────────────────────────
# Powers every AI surface (lead briefings, live copilot, call summaries,
# semantic ⌘K search, executive reports) with the Claude API.
# Without it the app gracefully uses built-in demo intelligence — nothing
# breaks; surfaces just show a "Demo AI" badge instead of "Claude".
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── ElevenLabs Conversational AI (optional) ──────────────────────────────────
# Lets the AI agent actually CONDUCT outbound calls (voice + recording), then
# stream transcripts/results back so Claude can summarize, qualify, and book.
# Without these the "AI agent dialing" controls show a connect prompt; the rest
# of the dialer is unaffected.
#   ELEVENLABS_API_KEY            → Profile → API Keys
#   ELEVENLABS_AGENT_ID           → Conversational AI → your agent → Agent ID
#   ELEVENLABS_AGENT_PHONE_NUMBER_ID → Conversational AI → Phone Numbers → (the
#                                   imported Twilio number) → Phone number ID
#   ELEVENLABS_WEBHOOK_SECRET     → the post-call webhook signing secret
#   ELEVENLABS_TRANSFER_NUMBER    → E.164 rep number a supervisor "take over"
#                                   transfers the live call to (optional)
#   ELEVENLABS_USE_DASHBOARD_PROMPT → "true" to run the script you pasted into the
#                                   ElevenLabs dashboard instead of the app's. The
#                                   app then sends ONLY personalization variables
#                                   (name, address, …) and no prompt override. Use
#                                   this when the agent's "overrides" toggles are
#                                   OFF. If they're ON, leave this unset/false so
#                                   the app injects the script per call. (Sending a
#                                   disallowed override makes ElevenLabs end the
#                                   call the instant it connects — this flag must
#                                   match your agent's override settings.)
#
# IMPORTANT — so the agent ends calls on its own (don't rely on the homeowner):
#   1. In the ElevenLabs agent → Tools, enable the built-in "End call" system
#      tool. Without it the agent can't hang up and the call stays open until the
#      homeowner does.
#   2. In the agent prompt, add closing guidance, e.g. "When the conversation is
#      finished or the homeowner needs to go, briefly confirm, thank them, and
#      use the End call tool to hang up." The dialer also auto-ends + categorizes
#      any call that connects, fails, never answers, or runs long — as a backstop.
#   3. Point the post-call webhook at  <your-app>/api/elevenlabs/webhook  so
#      results are captured even when no one is watching the Live Monitor.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TRANSFER_NUMBER=
ELEVENLABS_USE_DASHBOARD_PROMPT=

# ── Twilio (optional) ────────────────────────────────────────────────────────
# Without these, the dialer runs in "offline" mode (calling disabled, no
# simulation). Add them to place real browser calls.

# Twilio Account (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# API Key + Secret — mints Voice access tokens for the browser SDK.
# Console → Account → API keys & tokens → Standard key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# TwiML Application SID — its Voice URL must point at  /api/twilio/voice
# Console → Voice → TwiML → TwiML Apps
TWILIO_TWIML_APP_SID=

# The Twilio phone number used as caller ID (E.164, e.g. +14155551234)
TWILIO_CALLER_ID=

# ── Live listening for AI calls (relay-free) ─────────────────────────────────
# Optional. A Twilio number you own, dedicated to bridging AI calls into a
# conference so anyone can listen live — exactly like human calls, no media
# relay. When set, an AI call dials this number; the app moves that leg into a
# per-call conference room and dials the homeowner in. Listeners join the room
# muted via the Voice SDK.
#   • Must be a Twilio number whose Voice "A call comes in" webhook is set to
#     {NEXT_PUBLIC_APP_URL}/api/twilio/voice (HTTP POST) — the same webhook the
#     dialer already uses. Requires TWILIO_CALLER_ID + Twilio REST credentials.
#   • Leave blank to keep AI calls dialing the homeowner directly (no live
#     listening unless the MEDIA_STREAM_* relay is configured instead).
# Note: verify the agent's opening line timing on a live test call.
TWILIO_AI_BRIDGE_NUMBER=

# Public base URL Twilio can reach for webhooks/status callbacks.
# ⚠️ MUST be a public URL. "localhost" is NOT reachable by Twilio and causes
#    21609 (Invalid StatusCallback) / 11200 (HTTP retrieval failure) errors.
#    Local dev: use an ngrok/tunnel URL. Production: your deployed https origin.
# In production this is auto-derived from the request if left unset, but setting
# it explicitly is recommended.
NEXT_PUBLIC_APP_URL=

# ── Superadmin (hidden platform overseer) ────────────────────────────────────
# Superadmin is now tied to your REAL Supabase login — no separate password or
# cookie. List the email(s) that should have hidden god-mode (comma-separated).
# These accounts can shut the app off, suspend/delete accounts, manage every org,
# and grant platform access to others — and can never be locked out. It's never
# shown on the profile; reach the Control Center from the discreet entry.
# You can also promote others from the console (stored in the platform_admins
# table). Account management + kill switch require SUPABASE_SERVICE_ROLE_KEY.
SUPERADMIN_EMAILS=
